
@model IEnumerable<Product_Lab_6.Models.Product>

@{
    Layout = null;
    ViewBag.Title = "Product Catalog";
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>My Product Catalog</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #202326;
            color: white;
        }

        header {
            background: #1769aa;
            padding: 22px 5%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 15px;
        }

            header h1 {
                margin: 0 0 8px;
            }

            header p {
                margin: 0;
            }

        .cart-button {
            background: white;
            color: #1769aa;
            border: 0;
            padding: 12px 18px;
            border-radius: 7px;
            font-weight: bold;
            cursor: pointer;
        }

        .container {
            max-width: 1250px;
            margin: 30px auto;
            padding: 0 20px;
        }

        .heading {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 22px;
            gap: 10px;
            flex-wrap: wrap;
        }

        .products {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
            gap: 22px;
        }

        .card {
            background: #111;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 4px 14px #0003;
        }

            .card img {
                width: 100%;
                height: 190px;
                object-fit: cover;
                display: block;
            }

        .details {
            padding: 17px;
        }

        .category {
            color: #65aaff;
            font-size: 13px;
        }

        .details h3 {
            margin: 10px 0;
        }

        .description {
            color: #b9c5d4;
            min-height: 35px;
            font-size: 14px;
        }

        .price {
            color: #42c76b;
            font-size: 22px;
            font-weight: bold;
            margin: 16px 0;
        }

        .actions {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
        }

        .btn {
            padding: 10px 12px;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            font-weight: bold;
        }

        .view-btn {
            background: #334155;
            color: white;
        }

        .add-btn {
            background: #1769aa;
            color: white;
        }

        .btn:hover, .cart-button:hover {
            opacity: .85;
        }

        .overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: #000b;
            z-index: 10;
            padding: 20px;
            overflow-y: auto;
        }

        .modal {
            background: #24282d;
            color: white;
            max-width: 480px;
            margin: 45px auto;
            padding: 22px;
            border-radius: 12px;
        }

            .modal img {
                width: 100%;
                height: 230px;
                object-fit: cover;
                border-radius: 8px;
            }

        .close-btn {
            float: right;
            background: #dc3545;
            color: white;
        }

        .cart-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 10px;
            padding: 12px 0;
            border-bottom: 1px solid #555;
        }

        .quantity button {
            padding: 5px 9px;
            cursor: pointer;
        }

        .remove-btn {
            background: #dc3545;
            color: white;
            border: 0;
            border-radius: 4px;
            padding: 7px;
            cursor: pointer;
        }

        .total {
            color: #42c76b;
            font-size: 22px;
            font-weight: bold;
        }

        .empty {
            color: #cbd5e1;
            padding: 15px 0;
        }

        footer {
            text-align: center;
            padding: 25px;
            color: #aaa;
        }
    </style>
</head>

<body>

    <header>
        <div>
            <h1>My Product Catalog</h1>
            <p>Explore our collection of quality products.</p>
        </div>

        <button class="cart-button" onclick="openCart()">
            🛒 My Cart (<span id="cartCount">0</span>)
        </button>
    </header>

    <div class="container">
        <div class="heading">
            <h2>Our Products</h2>
            <span>Total Products: @Model.Count()</span>
        </div>

        <div class="products">
            @foreach (var item in Model)
            {
                <div class="card">
                    <img src="@item.ImageUrl"
                         alt="@item.Name"
                         onerror="this.onerror=null;this.src='https://placehold.co/600x400?text=Product';" />

                    <div class="details">
                        <span class="category">@item.Category</span>
                        <h3>@item.Name</h3>
                        <p class="description">@item.Description</p>

                        <div class="price">
                            ₹@item.Price.ToString("N0")
                        </div>

                        <div class="actions">

                            <button class="btn add-btn"
                                    data-id="@item.Id"
                                    data-name="@item.Name"
                                    data-price="@item.Price"
                                    data-image="@item.ImageUrl"
                                    onclick="addToCart(this)">
                                + Add to Cart
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Shopping Cart Popup -->
    <div class="overlay" id="cartOverlay"
         onclick="if(event.target===this)closeCart()">
        <div class="modal">
            <button class="btn close-btn"
                    onclick="closeCart()">
                Close ✕
            </button>

            <div style="clear:both;height:12px"></div>
            <h2>🛒 Shopping Cart</h2>

            <div id="cartItems"></div>

            <hr />
            <p>Total: <span class="total" id="cartTotal">₹0</span></p>

            <button class="btn view-btn" onclick="clearCart()">
                Clear Cart
            </button>
        </div>
    </div>

    <footer>
        Product Catalog Application | ASP.NET MVC
    </footer>

    <script>
                    var cart = {};

                    function formatPrice(price) {
                        return "₹" + Number(price).toLocaleString("en-IN", {
                            maximumFractionDigits: 2
                        });
                    }

                    function addToCart(button) {
                        var id = button.dataset.id;
                        var name = button.dataset.name;
                        var price = Number(button.dataset.price);
                        var image = button.dataset.image;

                        if (cart[id]) {
                            cart[id].quantity++;
                        } else {
                            cart[id] = {
                                id: id,
                                name: name,
                                price: price,
                                image: image,
                                quantity: 1
                            };
                        }

                        updateCart();
                        button.textContent = "Added ✓";

                        setTimeout(function () {
                            button.textContent = "+ Add to Cart";
                        }, 900);
                    }

                    function updateCart() {
                        var count = 0;
                        var total = 0;
                        var html = "";

                        Object.keys(cart).forEach(function (id) {
                            var item = cart[id];
                            count += item.quantity;
                            total += item.price * item.quantity;

                            html += '<div class="cart-row">' +
                                '<div><strong>' + escapeHtml(item.name) +
                                '</strong><br>' + formatPrice(item.price) +
                                '<div class="quantity">' +
                                '<button onclick="changeQty(\'' + id +
                                '\',-1)">−</button> ' + item.quantity +
                                ' <button onclick="changeQty(\'' + id +
                                '\',1)">+</button></div></div>' +
                                '<button class="remove-btn" onclick="removeItem(\'' +
                                id + '\')">Remove</button></div>';
                        });

                        if (count === 0) {
                            html = '<p class="empty">Your cart is empty.</p>';
                        }

                        document.getElementById("cartCount").textContent = count;
                        document.getElementById("cartItems").innerHTML = html;
                        document.getElementById("cartTotal").textContent =
                            formatPrice(total);
                    }

                    function escapeHtml(value) {
                        return String(value).replace(/[&<>"']/g, function (c) {
                            return {
                                "&": "&amp;",
                                "<": "&lt;",
                                ">": "&gt;",
                                '"': "&quot;",
                                "'": "&#39;"
                            }[c];
                        });
                    }

                    function changeQty(id, amount) {
                        if (!cart[id]) return;

                        cart[id].quantity += amount;

                        if (cart[id].quantity <= 0) {
                            delete cart[id];
                        }

                        updateCart();
                    }

                    function removeItem(id) {
                        delete cart[id];
                        updateCart();
                    }

                    function clearCart() {
                        cart = {};
                        updateCart();
                    }

                    function openCart() {
                        updateCart();
                        document.getElementById("cartOverlay").style.display = "block";
                    }

                    function closeCart() {
                        document.getElementById("cartOverlay").style.display = "none";
                    }

                    updateCart();
    </script>

</body>
</html>
